PORT=4000
DATABASE_URL=postgres://postgres:postgres@postgres:5432/smart_dunning
REDIS_URL=redis://redis:6379
ML_SERVICE_URL=http://ml-service:8000
FRONTEND_ORIGIN=http://localhost:5173

# HMAC secret configured in the Razorpay Dashboard webhook settings.
RAZORPAY_WEBHOOK_SECRET=replace_with_your_webhook_secret

# Optional: only needed to place *real* recurring charges via the Razorpay API.
# Leave unset to run the retry worker in deterministic simulation mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
